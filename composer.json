    "type": "flarum-extension",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": { "PeopleInside\\FestiveDecorations\\": "src/" }
    },
    "extra": {
        "flarum-extension": {
            "title": "Decorazioni Festive",
            "category": "feature",
            "icon": { "name": "fas fa-snowflake", "color": "#fff", "backgroundColor": "#c62828" }
        }
    }
}
